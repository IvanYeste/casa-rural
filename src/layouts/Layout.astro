---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "La Caseta del Fuster | Casa rural en Portell de Morella",
  description = "Escapadas en la naturaleza: 2 habitaciones de matrimonio, 1 individual, bodega y rutas por Els Ports.",
} = Astro.props as Props;
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-800">
    <header
      class="sticky top-0 z-40 bg-white/85 backdrop-blur border-b border-wood/30"
    >
      <nav class="max-w-6xl mx-auto flex items-center justify-between p-4">
        <a href="/" class="font-display text-2xl text-brand"
          >La Caseta del Fuster</a
        >
        <div class="flex gap-4 text-sm">
          <a href="#casa" class="hover:underline">La casa</a>
          <a href="#galeria" class="hover:underline">Galería</a>
          <a href="#actividades" class="hover:underline">Actividades</a>
          <a href="#precios" class="hover:underline">Precios</a>
          <a href="#ubicacion" class="hover:underline">Ubicación</a>
          <a href="/contacto" class="btn-brand">Contacto</a>
        </div>
      </nav>
      <div class="h-1 w-full bg-wood"></div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-16 border-t border-wood/30 bg-white">
      <div
        class="max-w-6xl mx-auto p-6 text-sm flex flex-col md:flex-row gap-4 md:items-center md:justify-between"
      >
        <p>© {new Date().getFullYear()} La Caseta del Fuster</p>
        <p>
          Síguenos en <a
            class="underline"
            href="https://www.instagram.com/lacasetadelfuster"
            target="_blank"
            rel="noreferrer">@lacasetadelfuster</a>
        </p>
      </div>
    </footer>
  </body>
</html>
