---
const title = "Contacto | Casa Rural";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body style="font-family: system-ui; margin: 0; line-height: 1.5;">
    <header style="padding: 1rem; border-bottom: 1px solid #eee;">
      <nav style="max-width: 960px; margin: 0 auto; display:flex; gap:1rem;">
        <a href="/">Inicio</a>
        <a href="/contacto">Contacto</a>
      </nav>
    </header>

    <main style="max-width: 960px; margin: 2rem auto; padding: 0 1rem;">
      <h1>Contacto</h1>

      <!-- FORMULARIO NETLIFY -->
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/gracias"
        style="display:grid; gap: 1rem; max-width: 640px;"
      >
        <!-- Requerido por Netlify Forms -->
        <input type="hidden" name="form-name" value="contacto" />

        <!-- Honeypot (anti-spam) -->
        <p class="hidden" style="display:none;">
          <label>No rellenes: <input name="bot-field" /></label>
        </p>

        <label
          >Nombre
          <input name="nombre" type="text" required minlength="2" />
        </label>

        <label
          >Email
          <input name="email" type="email" required />
        </label>

        <label
          >Teléfono (opcional)
          <input name="telefono" type="tel" inputmode="tel" />
        </label>

        <label
          >Mensaje
          <textarea name="mensaje" required minlength="10"></textarea>
        </label>

        <label style="font-size: 0.95rem;">
          <input type="checkbox" name="rgpd" required />
          He leído y acepto la <a href="/privacidad" target="_blank"
            >política de privacidad</a
          >.
        </label>

        <button type="submit" style="padding: .6rem 1rem; cursor: pointer;">
          Enviar
        </button>
      </form>
    </main>
  </body>
</html>
