---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- HERO -->
  <section class="relative">
    <img
      src="src/assets/imagenes/placeholder.jpeg"
      alt="La Caseta del Fuster"
      class="h-[60vh] w-full object-cover"
    />
    <div class="absolute inset-0 bg-brand/35"></div>
    <div class="absolute inset-0 max-w-6xl mx-auto px-6 flex items-end pb-10">
      <div class="text-white drop-shadow">
        <h1 class="text-4xl md:text-5xl font-display">Escápate a Els Ports</h1>
        <p class="mt-3 max-w-xl text-white/95">
          Tranquilidad, naturaleza y una casa con todo lo necesario.
        </p>
        <div class="mt-6 flex gap-3">
          <a href="/contacto" class="btn-brand">Consultar disponibilidad</a>
          <a href="#galeria" class="btn-ghost">Ver fotos</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LA CASA -->
  <section id="casa" class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="text-3xl font-display mb-4 text-brand">La casa</h2>
        <p class="text-stone-600">
          Situada en Portell de Morella, es perfecta para familias, amigos o
          parejas que buscan descanso y naturaleza.
        </p>
        <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🛏️ 2 habitaciones de matrimonio
          </li>
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🧑‍🍼 1 habitación individual
          </li>
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🛋️ Sofá cama
          </li>
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🍳 Cocina equipada (lavavajillas)
          </li>
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🛁 3 baños
          </li>
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🔥 Calefacción
          </li>
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🍷 Bodega
          </li>
          <li
            class="flex items-start gap-3 border border-wood/30 rounded-md p-2"
          >
            🏠 Salón con cocina integrada
          </li>
        </ul>
        <p class="mt-6 text-sm text-stone-500">
          Dirección: Calle Mayor, 31 – 12318 Portell de Morella.
        </p>
        <div class="mt-6">
          <a href="/contacto" class="btn-brand">Quiero reservar</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-xl object-cover h-40 w-full"
          alt="Dormitorio"
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-xl object-cover h-40 w-full"
          alt="Cocina"
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-xl object-cover h-40 w-full"
          alt="Bodega"
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-xl object-cover h-40 w-full"
          alt="Salón"
        />
      </div>
    </div>
  </section>

  <!-- GALERÍA -->
  <section id="galeria" class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-3xl font-display mb-6 text-brand">Galería</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
        <img
          src="src/assets/imagenes/placeholder.jpeg"
          class="rounded-lg object-cover h-56 w-full"
          alt=""
        />
      </div>
      <p class="mt-4 text-sm text-stone-500">
        Síguenos en Instagram para más fotos:
        <a
          class="underline"
          href="https://www.instagram.com/lacasetadelfuster"
          target="_blank"
          rel="noreferrer">@lacasetadelfuster</a
        >
      </p>
    </div>
  </section>

  <!-- ACTIVIDADES -->
  <section id="actividades" class="bg-stone-100">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-3xl font-display mb-6 text-brand">
        Actividades en Portell
      </h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 text-sm">
        <div
          class="rounded-xl bg-white p-4 border border-wood/40 hover:border-brand/60 transition"
        >
          🎾 Pista de pádel
        </div>
        <div
          class="rounded-xl bg-white p-4 border border-wood/40 hover:border-brand/60 transition"
        >
          🏐 Frontón
        </div>
        <div
          class="rounded-xl bg-white p-4 border border-wood/40 hover:border-brand/60 transition"
        >
          🥾 Rutas por Pont de la Rambla y el Toll d’en Drac
        </div>
        <div
          class="rounded-xl bg-white p-4 border border-wood/40 hover:border-brand/60 transition"
        >
          🚵 Rutas BTT
        </div>
      </div>
    </div>
  </section>

  <!-- PRECIOS -->
  <section id="precios" class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-display mb-6 text-brand">Precios</h2>
    <div class="rounded-2xl border border-wood/40 bg-white p-6">
      <p class="text-2xl font-semibold text-brand">200 €/día</p>
      <ul class="mt-3 text-sm text-stone-600 list-disc pl-5">
        <li>Suplemento de limpieza si traes mascota.</li>
        <li>
          Festivos (puentes, Pascua, Navidad…): consultar disponibilidad y
          precio.
        </li>
      </ul>
      <a href="/contacto" class="mt-5 inline-block btn-brand">Consultar</a>
    </div>
  </section>

  <!-- UBICACIÓN -->
  <section id="ubicacion" class="bg-stone-100">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-3xl font-display mb-4 text-brand">Cómo llegar</h2>
      <p class="text-sm text-stone-600 mb-4">
        C/ Mayor, 31 – 12318 Portell de Morella.
      </p>
      <div
        class="aspect-[16/9] w-full overflow-hidden rounded-xl border border-wood/30"
      >
        <iframe
          class="w-full h-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=Portell+de+Morella&output=embed"
        >
        </iframe>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-6xl mx-auto px-6 py-16 text-center">
    <h2 class="text-3xl font-display text-brand">¿Hablamos?</h2>
    <div class="mx-auto my-3 h-1 w-24 bg-wood rounded-full"></div>
    <p class="mt-2 text-stone-600">Escríbenos y te respondemos rápido.</p>
    <a href="/contacto" class="mt-5 inline-block btn-brand">Contactar</a>
  </section>
</Layout>
